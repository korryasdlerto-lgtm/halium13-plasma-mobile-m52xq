 
lxc.rootfs.path = /var/lib/lxc/android/rootfs
lxc.init.cmd = /init second_stage
lxc.uts.name = armhf

lxc.log.syslog = daemon
# Uncomment for more debugging info.
# lxc.log.level = 3

# REMOVED 2026-07-21 (live test, second round): removing
# "lxc.namespace.keep = net user" alone did NOT fix "File exists --
# Failed to allocate new network namespace id" (same fatal abort even
# without it, confirmed live -- md5-verified config had the line gone,
# error persisted identically). Commenting out THIS line too changed
# lxc_spawn's behavior: log now shows "Cloned CLONE_NEWNET" (container
# gets its OWN network namespace) instead of "Preserved net namespace"
# followed immediately by the EEXIST abort -- the netns error is GONE.
# Container still fails after this (killed by the halium-kickstart-lxc
# zygote-stuck watchdog a few seconds later, next blocker under
# investigation), but this specific barrier is cleared. Container loses
# host network access this way (no A-GPS/VoLTE) -- acceptable trade,
# revisit once the container boots at all.
#lxc.net.0.type = none

# REMOVED 2026-07-21 (live test): "lxc.namespace.keep = net user" (added
# for container internet access -- A-GPS/VoLTE) caused lxc_spawn to
# abort with "File exists - Failed to allocate new network namespace id"
# -- Control process exited status=1/FAILURE, container never even
# reaches mount.sh. v2's history (DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md,
# 2026-07-19) called this warning harmless on THAT LXC/kernel state, but
# here (LXC 5.0.2, after many repeated same-boot restart attempts
# tonight) it's fatal -- likely a stale kernel-side nsid registration
# accumulated from earlier retries this session. Removing it lets the
# container reach the fully-patched mount.sh below (all v2 findings
# already present here) -- container internet access can be revisited
# separately once the container boots at all.
#lxc.namespace.keep = net user

lxc.tty.dir = lxc
lxc.tty.max = 4
lxc.pty.max = 1024
lxc.cap.drop = mac_admin mac_override

lxc.hook.pre-start = /var/lib/lxc/android/pre-start.sh
lxc.hook.mount = /var/lib/lxc/android/mount.sh
lxc.hook.post-stop = /var/lib/lxc/android/post-stop.sh

lxc.apparmor.profile = unconfined
lxc.autodev = 0

# Doing part of Android's first stage init
lxc.mount.entry = tmpfs dev tmpfs nosuid,mode=0755 0 0
lxc.mount.entry = /dev/__properties__ dev/__properties__ bind bind,create=dir 0 0
lxc.mount.entry = /dev/binderfs dev/binderfs bind bind,create=dir,optional 0 0
lxc.mount.entry = /dev/socket dev/socket bind bind,create=dir 0 0
# The fresh tmpfs mounted onto dev/ above starts empty, wiping out
# mount.sh's earlier mknod of dev/kmsg -- which meant init's own fatal
# error/reboot-reason messages (it logs exclusively via /dev/kmsg) went
# nowhere and were invisible for this whole project until this was added.
# See DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md, 2026-07-18. (dev/ptmx is
# deliberately NOT bind-mounted here: LXC needs to replace it itself when
# setting up its own devpts instance, and a pre-existing bind-mount there
# breaks that setup with EBUSY.)
lxc.mount.entry = /dev/kmsg dev/kmsg none bind,create=file,optional 0 0
lxc.mount.entry = /dev/null dev/null none bind,create=file,optional 0 0
lxc.mount.entry = /dev/zero dev/zero none bind,create=file,optional 0 0
lxc.mount.entry = /dev/random dev/random none bind,create=file,optional 0 0
lxc.mount.entry = /dev/urandom dev/urandom none bind,create=file,optional 0 0
# proc/sys/selinuxfs: REMOVED 2026-07-18 (conflicted with first_stage's
# own mount attempt -> EBUSY -> InitFatalReboot), RESTORED 2026-07-19.
# Root cause of the removal was misdiagnosed: we ALWAYS invoke
# "/init second_stage" directly (see start-android-container), which
# NEVER runs first_stage, so first_stage can never actually conflict with
# these. But second_stage itself does NOT mount proc/sys at all (that is
# exclusively FirstStageMain's job in AOSP init) -- it assumes them
# already mounted and inherited via SwitchRoot. Confirmed via live
# /proc/<pid>/mountinfo capture (kill -STOP right after lxc-start) that
# /proc was a completely empty, unmounted directory in the container's
# own mount namespace -- explains "Unable to write -1000 to
# /proc/1/oom_score_adj: No such file or directory" in kmsg and is the
# leading suspect for the PropertyInfoArea::GetPropertyInfoIndexes NULL
# this-pointer SIGSEGV (property/bionic init code paths that stat/open
# via /proc during early second_stage would silently fail with no procfs
# present). See DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md 2026-07-19.
lxc.mount.entry = proc proc proc nodev,noexec,nosuid 0 0
lxc.mount.entry = sys sys sysfs nodev,noexec,nosuid 0 0
lxc.mount.entry = selinuxfs sys/fs/selinux selinuxfs optional 0 0
# ОТКАЧЕНО 2026-07-19 (Находка 22, живой тест): Находка 18 монтировала
# сюда ГОЛЫЙ cgroup2 (весь глобальный корень хостовой иерархии,
# nsdelegate) -- это дало init'у РЕАЛЬНЫЙ (не "не смонтирован") cgroup2,
# но createProcessGroup() пытается писать в /uid_0/pid_X/cgroup.procs
# ОТНОСИТЕЛЬНО ГЛОБАЛЬНОГО корня, а не в СВОЁ делегированное поддерево
# (/sys/fs/cgroup/lxc.payload.android-N, где реально живёт /init) --
# nsdelegate это запрещает (EROFS) ДЛЯ АБСОЛЮТНО ЛЮБОГО сервиса,
# включая сам zygote (createProcessGroup(0,PID) failed -> Service
# failed to start due to a fatal error, тугой рестарт-цикл КАЖДОГО
# сервиса). Пробовали bind именно правильного делегированного
# поддерева из mount.sh -- НЕ ПОМОГЛО (тот же EROFS даже для верного
# пути, вероятно cgroup.subtree_control/no-internal-process нюансы).
# БЕЗ этого mount.entry (т.е. /sys/fs/cgroup внутри контейнера вообще
# НЕ смонтирован) createProcessGroup просто МЯГКО предупреждает
# ("cpuset cgroup controller is not mounted!") и НЕ блокирует старт
# сервисов -- это и был реальный рабочий режим ДО Находки 18. Находка
# 18 таким образом была не просто бесполезной (как считалось после
# трёх экспериментов), а АКТИВНО ВРЕДНОЙ. См.
# DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md Находка 22.
#lxc.mount.entry = cgroup2 sys/fs/cgroup cgroup2 rw,nosuid,nodev,noexec,relatime,nsdelegate,optional 0 0

# /system/bin/env exec hits ELOOP on this device (see start-android-container
# comment) -- set env vars natively via lxc instead of the env -i wrapper.
lxc.environment = PATH=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/sbin:/system/sbin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin
lxc.environment = INIT_STARTED_AT=0
# НАЙДЕНО 2026-07-19: linkerconfig (started by init's own "update_linker_config"
# early-init command) aborts with SIGABRT: 'Check failed: !"undefined var"
# SANITIZER_DEFAULT_VENDOR is not defined' -- this env var is normally set by
# FirstStageMain's own environment setup, which we always skip. Non-fatal to
# init itself (it logs and continues), but linkerconfig never actually builds
# a working ld.config.txt this way. See DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md
# Находка 16.
lxc.environment = SANITIZER_DEFAULT_VENDOR=none
# НАЙДЕНО 2026-07-19 (Находка 24): та же причина, что и у SANITIZER_DEFAULT_VENDOR
# выше (Находка 16) -- FirstStageMain обычно делает setenv() для ЭТИХ
# переменных ДО execve() в second_stage, мы всегда стартуем НАПРЯМУЮ с
# second_stage и теряем их. zygote/app_process64 и bootanimation
# аварийно прерываются (SIGABRT) сразу на старте: "ANDROID_DATA
# environment variable unset" / "ANDROID_ROOT not set" (подтверждено
# живым logcat через nsenter). См. DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md
# Находка 24.
lxc.environment = ANDROID_ROOT=/system
lxc.environment = ANDROID_DATA=/data
lxc.environment = ANDROID_STORAGE=/storage
lxc.environment = ANDROID_ASSETS=/system/app
lxc.environment = ANDROID_ART_ROOT=/apex/com.android.art
lxc.environment = ANDROID_I18N_ROOT=/apex/com.android.i18n
lxc.environment = ANDROID_TZDATA_ROOT=/apex/com.android.tzdata
lxc.environment = ANDROID_RUNTIME_ROOT=/apex/com.android.runtime
# НАЙДЕНО 2026-07-19 (Находка 31): installd падает с SIGSEGV мгновенно
# при старте -- backtrace: init_globals_from_data_and_root() ->
# strlen(NULL). Регистр x3 в крахе декодируется как ASCII "ANDROID_"
# (little-endian) -- ещё один getenv("ANDROID_*") внутри этой функции
# возвращает NULL, помимо уже установленных ROOT/DATA. Добавляем
# оставшиеся стандартные legacy-переменные, которые installd/vold
# традиционно тоже читают.
lxc.environment = ASEC_MOUNTPOINT=/mnt/asec
lxc.environment = EXTERNAL_STORAGE=/sdcard
lxc.environment = ANDROID_EXPAND=/mnt/expand
lxc.mount.entry = /android/data data bind bind,optional 0 0
lxc.mount.entry = /mnt mnt bind rbind,optional 0 0
# НАЙДЕНО 2026-07-19: /apex source doesn't exist on host at all (nothing to
# bind) -- this device ships FLATTENED apex modules (already-extracted
# directories, not .apex archive files) under /android/system/system/apex/
# (double "system/system" -- this device's system-as-root image nests its
# real content one level deeper). lxc-android-config's own mount-apexes.py
# looks for them at /android/system/apex (no double nesting) and so never
# finds them either -- same root cause, never triggered because
# lxc-android-config.service is disabled for manual testing anyway. Only
# bind-mount the specific modules android::init::SetupMountNamespaces()
# actually needs (matches mount-apexes.py's own hardcoded target list):
# runtime, art, i18n, vndk.current. Deliberately NOT tethering/resolv --
# see feedback memory: those two previously killed ssh/network at ~68s on
# every boot and never even fixed netd. See DROIDIAN-V2-SYSTEMD-FIX-HOWTO.md
# Находка 14. UPDATE: bind-mounting subdirs under a plain (non-mountpoint)
# apex/ dir isn't enough either -- SecondStageMain's SetupMountNamespaces()
# does mount(NULL, "/apex", NULL, MS_PRIVATE, NULL) which requires /apex
# ITSELF to already be a distinct mountpoint (EINVAL otherwise). Give it its
# own tmpfs first, same pattern as "tmpfs dev tmpfs" above.
lxc.mount.entry = tmpfs apex tmpfs nosuid,mode=0755,create=dir 0 0
lxc.mount.entry = /android/system/system/apex/com.android.runtime apex/com.android.runtime bind bind,optional,create=dir 0 0
lxc.mount.entry = /android/system/system/apex/com.android.art apex/com.android.art bind bind,optional,create=dir 0 0
lxc.mount.entry = /android/system/system/apex/com.android.i18n apex/com.android.i18n bind bind,optional,create=dir 0 0
lxc.mount.entry = /android/system/system/apex/com.android.vndk.current apex/com.android.vndk.current bind bind,optional,create=dir 0 0
# FOUND 2026-07-21 live: unlike every other bind entry above, these two
# were missing "create=dir" -- LXC's rootfs.path skeleton
# (/usr/lib/aarch64-linux-gnu/lxc/rootfs/) is an empty tmpfs, so without
# create=dir the destination directory doesn't exist and the mount hard-fails
# ("optional" alone only tolerates a missing SOURCE, not a missing
# destination) -- aborted the entire container setup ("Failed to setup
# container"). Confirmed live: adding create=dir fixed it.
lxc.mount.entry = /odm odm bind bind,optional,create=dir 0 0
lxc.mount.entry = /vendor_dlkm vendor_dlkm bind bind,optional,create=dir 0 0

