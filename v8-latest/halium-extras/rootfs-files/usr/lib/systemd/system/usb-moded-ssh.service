[Unit]
Description=OpenBSD Secure Shell server - USB moded rescue unit
Documentation=man:sshd(8) man:sshd_config(5)
After=network.target auditd.service
# In case we're started in charger mode (for debugging), starts systemd-user-
# sessions.service to remove /run/nologin and allow `phablet` to log in.
Wants=systemd-user-sessions.service

[Service]
EnvironmentFile=-/etc/default/ssh
# ssh-generate-hostkeys has to be run before config testing, otherwise testing
# will bail out because it also check for host keys. Because the test is defined
# in the main unit config, we have to clear the list first.
ExecStartPre=/usr/bin/ssh-generate-hostkeys
ExecStartPre=/usr/sbin/sshd -t

# We want to allow connection no matter the user has password or not, to make
# sure the rescue mission succeed, but on the USB connection only.
ExecStart=/usr/sbin/sshd -D $SSHD_OPTS \
    -o PasswordAuthentication=yes \
    -o PermitEmptyPasswords=yes \
    -o PermitRootLogin=no \
    -o ListenAddress=10.15.19.82:8022

ExecReload=/usr/sbin/sshd -t
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartPreventExitStatus=255
Type=notify
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
# We share /run/sshd with the main ssh.service, so it must be preserved.
RuntimeDirectoryPreserve=yes

# No WantedBy; it'll be started by usb-moded.
