[Unit]
Description=Copy halium_sensor_bridge from /data into /vendor/bin (never touches vendor.img itself)
After=lxc-android-config.service lightdm.service
Requires=lxc-android-config.service
Before=halium-sensor-bridge-watchdog.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/halium-install-sensor-bridge.sh

[Install]
WantedBy=multi-user.target
