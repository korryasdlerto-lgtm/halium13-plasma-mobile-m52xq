[Unit]
Description=Continuously capture kernel dmesg to persistent storage (catches early Android init console output before it reboots)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=simple
ExecStart=/bin/dmesg --follow --nopager
StandardOutput=append:/var/log/dmesg-continuous.log
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
