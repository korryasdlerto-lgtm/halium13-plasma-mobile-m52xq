[Unit]
Description=Disable com.android.phone (competes with oFono for the IRadio session, blocks network registration/USSD)
After=lxc-android-config.service
Before=ofono.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/halium-fix-phone-radio-conflict.sh

[Install]
WantedBy=multi-user.target
