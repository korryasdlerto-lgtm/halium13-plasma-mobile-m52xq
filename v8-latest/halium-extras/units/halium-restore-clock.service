[Unit]
Description=Restore system clock from persistent file at boot (fake-hwclock replacement, RTC write is blocked on this device)
DefaultDependencies=no
Before=sysinit.target
After=userdata.mount

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ -f /userdata/saved-clock.txt ]; then SAVED=$(cat /userdata/saved-clock.txt); NOW=$(date -u +%%s); [ "$SAVED" -gt "$NOW" ] && date -u -s "@$SAVED"; fi'

[Install]
WantedBy=sysinit.target
