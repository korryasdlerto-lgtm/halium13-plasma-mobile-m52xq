[Unit]
Description=Halium debug snapshot of USB/network state to persistent storage
After=usb-early-init-done.service
Wants=usb-early-init-done.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 100
ExecStart=/usr/libexec/halium-usb-debug.sh
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=basic.target
