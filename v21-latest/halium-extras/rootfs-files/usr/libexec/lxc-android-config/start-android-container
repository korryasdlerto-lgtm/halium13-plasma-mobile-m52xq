#!/bin/sh -euf

LOG=/userdata/android-data/lxc-android-start.log
LOG2=/android/data/lxc-android-start.log
echo "=== start-android-container $(date) ===" >> "$LOG" 2>/dev/null || true
echo "=== start-android-container $(date) ===" >> "$LOG2" 2>/dev/null || true

_log() { echo "$*" >> "$LOG" 2>/dev/null || true; echo "$*" >> "$LOG2" 2>/dev/null || true; }

if [ -f /android/system/system/build.prop ]; then
    api_level=$(sed -n 's/^ro.build.version.sdk=//p' /android/system/system/build.prop)
elif [ -f /android/system/build.prop ]; then
    api_level=$(sed -n 's/^ro.build.version.sdk=//p' /android/system/build.prop)
else
    api_level=33
fi
api_level=${api_level:-33}

_log "api_level=$api_level"
_log "android dir: $(ls /android/ 2>/dev/null | tr '\n' ' ')"
_log "lxc rootfs: $(ls /var/lib/lxc/android/rootfs/ 2>/dev/null | tr '\n' ' ')"
_log "init symlink: $(readlink /var/lib/lxc/android/rootfs/init 2>/dev/null)"
_log "rootfs/system: $(ls /var/lib/lxc/android/rootfs/system/ 2>/dev/null | head -5 | tr '\n' ' ' || echo NOT_EXIST)"
_log "/android/system/system/bin/init: $(ls -la /android/system/system/bin/init 2>/dev/null || echo NOT_FOUND)"
_log "/android/vendor exists: $(ls /android/vendor/ 2>/dev/null | head -3 | tr '\n' ' ')"
_log "__properties__ count: $(ls /dev/__properties__/ 2>/dev/null | wc -l)"

if [ "$api_level" -le 22 ]; then
    stage2_arg=""
elif [ "$api_level" -le 25 ]; then
    stage2_arg="--second-stage"
elif [ "$api_level" -le 28 ]; then
    stage2_arg=""
    export INIT_SECOND_STAGE=true
else
    stage2_arg="second_stage"
fi

_log "About to run halium-lxc-bridge-libs.sh"
[ -x /usr/libexec/halium-lxc-bridge-libs.sh ] && timeout 10 /usr/libexec/halium-lxc-bridge-libs.sh 2>/dev/null || true
_log "halium-lxc-bridge-libs.sh call returned"
_log "Running lxc-start with stage2_arg=$stage2_arg"

exec /usr/bin/lxc-start -n android -F \
    --logfile=/userdata/lxc-debug.log \
    --logpriority=ERROR \
    -- \
    /init $stage2_arg
