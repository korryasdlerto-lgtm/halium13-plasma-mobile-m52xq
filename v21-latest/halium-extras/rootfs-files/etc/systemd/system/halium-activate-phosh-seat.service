[Unit]
Description=Poll and activate the tty7 logind session so phoc's DRM backend doesn't time out waiting for session activation
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/libexec/halium-activate-phosh-seat.sh
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
