[Unit]
Description=libhybris bridge: copy base + Adreno GPU libs into LXC container tmpfs rootfs (every boot, destination is ephemeral)
After=lxc-android-config.service userdata.mount
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/halium-lxc-bridge-libs.sh

[Install]
WantedBy=multi-user.target
